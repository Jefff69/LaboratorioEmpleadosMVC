@model LaboratorioEmpleadosMVC.Models.EmpleadoInsertarViewModel

@{
    ViewBag.Title = "Insertar Empleado";
}

<h2>
    @(Model.Id > 0 ? "Actualizar Empleado" : "Insertar Empleado")
</h2>


@if (ViewBag.Mensaje != null)
{
    <div class="alert alert-info">
        @ViewBag.Mensaje
    </div>
}

@using (Html.BeginForm("InsertarEmpleados", "Empleado", FormMethod.Post, new { @class = "form-horizontal" }))
{
    @Html.HiddenFor(model => model.Id)

    @Html.AntiForgeryToken()

    <div class="form-group">
        @Html.LabelFor(model => model.Nombre, new { @class = "control-label" })
        @Html.TextBoxFor(model => model.Nombre, new { @class = "form-control" })
        @Html.ValidationMessageFor(model => model.Nombre, "", new { @class = "text-danger" })
    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.Apellido, new { @class = "control-label" })
        @Html.TextBoxFor(model => model.Apellido, new { @class = "form-control" })
        @Html.ValidationMessageFor(model => model.Apellido, "", new { @class = "text-danger" })
    </div>

    <div class="form-group">
        <label class="control-label">Tipo de trabajador</label>

        <div>
            <label>
                @Html.RadioButtonFor(model => model.TipoTrabajador, 1)
                Empleado
            </label>

            <label style="margin-left: 20px;">
                @Html.RadioButtonFor(model => model.TipoTrabajador, 2)
                Supervisor
            </label>
        </div>

        @Html.ValidationMessageFor(model => model.TipoTrabajador, "", new { @class = "text-danger" })
    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.CostoHora, new { @class = "control-label" })
        @Html.TextBoxFor(model => model.CostoHora, new { @class = "form-control", type = "number" })
        @Html.ValidationMessageFor(model => model.CostoHora, "", new { @class = "text-danger" })
    </div>



    @* Dropdown para seleccionar la provincia. *@
    <div class="form-group">
        <label for="IdProvincia" class="control-label">Provincia</label>

        <select id="IdProvincia" name="IdProvincia" class="form-control">
            <option value="">Seleccione una provincia</option>
        </select>
    </div>

    @* Dropdown que se actualizará según la provincia seleccionada. *@
    <div class="form-group">
        <label for="IdCanton" class="control-label">Cantón</label>

        <select id="IdCanton" name="IdCanton" class="form-control" disabled>
            <option value="">Seleccione un cantón</option>
        </select>
    </div>

    @* Dropdown que se actualizará según el cantón seleccionado. *@
    <div class="form-group">
        @Html.LabelFor(model => model.IdDistrito, "Distrito",
            new { @class = "control-label" })

        <select id="IdDistrito" name="IdDistrito" class="form-control" disabled>
            <option value="">Seleccione un distrito</option>
        </select>

        @Html.ValidationMessageFor(
            model => model.IdDistrito,
            "",
            new { @class = "text-danger" }
        )
    </div>



    <div class="form-group">
        @Html.LabelFor(model => model.Estado, new { @class = "control-label" })
        @Html.CheckBoxFor(model => model.Estado)
        @Html.ValidationMessageFor(model => model.Estado, "", new { @class = "text-danger" })
    </div>

    <br />

    <button type="submit" class="btn btn-primary">
        @(Model.Id > 0 ? "Actualizar Empleado" : "Insertar Empleado")
    </button>



    if (Model.Id > 0)
    {
        @Html.ActionLink(
            "Eliminar Empleado",
            "ConfirmarEliminar",
            "Empleado",
            new { id = Model.Id },
            new { @class = "btn btn-danger" }
        )
    }




}



@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

<script>
        // Espera a que el formulario esté listo.
        $(document).ready(function () {

            // Referencias a los tres dropdowns.
            var provincia = $("#IdProvincia");
            var canton = $("#IdCanton");
            var distrito = $("#IdDistrito");


        // Valores recuperados del controlador para editar un empleado.
        var provinciaSeleccionada = parseInt('@(ViewBag.IdProvinciaSeleccionada ?? 0)', 10);
        var cantonSeleccionado = parseInt('@(ViewBag.IdCantonSeleccionado ?? 0)', 10);
        var distritoSeleccionado = parseInt('@(ViewBag.IdDistritoSeleccionado ?? 0)', 10);


            // Carga todas las provincias desde el controlador.
            function cargarProvincias() {
                $.getJSON('@Url.Action("ObtenerProvincias", "Empleado")')
                    .done(function (datos) {

                        // Limpia las opciones anteriores.
                        provincia.empty();
                        provincia.append(
                            $("<option>").val("").text("Seleccione una provincia")
                        );

                        // Agrega las provincias recibidas.
                        $.each(datos, function (i, item) {
                            provincia.append(
                                $("<option>").val(item.Value).text(item.Text)
                            );
                        });

                        // Restaura la provincia del empleado al editar.
                        if (provinciaSeleccionada > 0) {
                            provincia.val(String(provinciaSeleccionada));
                            cargarCantones(provinciaSeleccionada);
                        }
                    })
                    .fail(function () {
                        alert("No fue posible cargar las provincias.");
                    });
            }

            // Carga los cantones correspondientes a una provincia.
            function cargarCantones(idProvincia) {
                canton.empty().append(
                    $("<option>").val("").text("Seleccione un cantón")
                );
                distrito.empty().append(
                    $("<option>").val("").text("Seleccione un distrito")
                );

                canton.prop("disabled", true);
                distrito.prop("disabled", true);

                if (!idProvincia) {
                    return;
                }

                $.getJSON(
                    '@Url.Action("ObtenerCantones", "Empleado")',
                    { idProvincia: idProvincia }
                )
                .done(function (datos) {

                    // Agrega las opciones de cantón.
                    $.each(datos, function (i, item) {
                        canton.append(
                            $("<option>").val(item.Value).text(item.Text)
                        );
                    });

                    canton.prop("disabled", false);

                    // Restaura el cantón guardado al editar.
                    if (cantonSeleccionado > 0) {
                        canton.val(String(cantonSeleccionado));
                        cargarDistritos(cantonSeleccionado);
                    }
                })
                .fail(function () {
                    alert("No fue posible cargar los cantones.");
                });
            }

            // Carga los distritos correspondientes a un cantón.
            function cargarDistritos(idCanton) {
                distrito.empty().append(
                    $("<option>").val("").text("Seleccione un distrito")
                );
                distrito.prop("disabled", true);

                if (!idCanton) {
                    return;
                }

                $.getJSON(
                    '@Url.Action("ObtenerDistritosPorCanton", "Empleado")',
                    { idCanton: idCanton }
                )
                .done(function (datos) {

                    // Agrega las opciones de distrito.
                    $.each(datos, function (i, item) {
                        distrito.append(
                            $("<option>").val(item.Value).text(item.Text)
                        );
                    });

                    distrito.prop("disabled", false);

                    // Restaura el distrito guardado al editar.
                    if (distritoSeleccionado > 0) {
                        distrito.val(String(distritoSeleccionado));
                    }
                })
                .fail(function () {
                    alert("No fue posible cargar los distritos.");
                });
            }

            // Al cambiar la provincia, se actualizan los cantones.
            provincia.on("change", function () {
                // Evita reutilizar las selecciones anteriores.
                cantonSeleccionado = 0;
                distritoSeleccionado = 0;

                cargarCantones($(this).val());
            });

            // Al cambiar el cantón, se actualizan los distritos.
            canton.on("change", function () {
                // El distrito anterior ya no necesariamente corresponde.
                distritoSeleccionado = 0;

                cargarDistritos($(this).val());
            });

            // Inicia la carga de provincias al abrir el formulario.
            cargarProvincias();
        });
</script>
}

